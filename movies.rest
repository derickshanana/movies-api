### =====================
### LOCAL
### =====================

### Get all movies
GET http://localhost:3000/movies

### Get movie by id
GET http://localhost:3000/movies/PUT_A_REAL_MOVIE_ID_HERE

### Create a movie (valid)
POST http://localhost:3000/movies
content-type: application/json

{
  "title": "Glass Horizon",
  "director": "Rita Alvarez",
  "releaseYear": 2022,
  "genre": "Drama",
  "rating": 8.1,
  "runtimeMinutes": 111,
  "synopsis": "A glassblower rebuilds her life after losing her studio in a fire."
}

### Create a movie (INVALID - missing fields, should return 400)
POST http://localhost:3000/movies
content-type: application/json

{
  "title": "Missing Fields Movie"
}

### Update a movie (valid)
PUT http://localhost:3000/movies/PUT_A_REAL_MOVIE_ID_HERE
content-type: application/json

{
  "title": "Glass Horizon",
  "director": "Rita Alvarez",
  "releaseYear": 2022,
  "genre": "Drama",
  "rating": 8.4,
  "runtimeMinutes": 111,
  "synopsis": "Updated synopsis after re-edit."
}

### Delete a movie
DELETE http://localhost:3000/movies/PUT_A_REAL_MOVIE_ID_HERE

### Get all reviews
GET http://localhost:3000/reviews

### Get review by id
GET http://localhost:3000/reviews/PUT_A_REAL_REVIEW_ID_HERE

### Create a review (valid)
POST http://localhost:3000/reviews
content-type: application/json

{
  "movieId": "PUT_A_REAL_MOVIE_ID_HERE",
  "reviewerName": "Taylor Brooks",
  "rating": 8,
  "comment": "Beautifully shot, really stuck with me.",
  "datePosted": "05/10/2024"
}

### Create a review (INVALID - bad movieId, should return 400)
POST http://localhost:3000/reviews
content-type: application/json

{
  "movieId": "not-a-valid-id",
  "reviewerName": "Taylor Brooks",
  "rating": 8,
  "comment": "test",
  "datePosted": "05/10/2024"
}

### Update a review
PUT http://localhost:3000/reviews/PUT_A_REAL_REVIEW_ID_HERE
content-type: application/json

{
  "movieId": "PUT_A_REAL_MOVIE_ID_HERE",
  "reviewerName": "Taylor Brooks",
  "rating": 9,
  "comment": "Updated my opinion after a rewatch - even better.",
  "datePosted": "05/12/2024"
}

### Delete a review
DELETE http://localhost:3000/reviews/PUT_A_REAL_REVIEW_ID_HERE


